# Copy to .env for local development.
# On Vercel, DATABASE_URL comes from the Storage integration — don't set it
# by hand, and leave BETTER_AUTH_URL unset (the production URL is detected).

# --- Database (Postgres) ------------------------------------------------------
# Local: run `npx prisma dev -n hq -d`, paste the postgres:// URL it prints,
# uncomment, and keep `pgbouncer=true&connection_limit=1` on the end — the
# local dev server shares one backend, so prepared statements must be off.
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"

# --- Auth ---------------------------------------------------------------------
# Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Local only (and on Vercel only for a custom domain):
# BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional — the Google button is disabled until both are set).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <your app URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Scheduled discovery ------------------------------------------------------
# Required in production: protects /api/cron/check-all.
CRON_SECRET=""
