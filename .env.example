# --- Database (Postgres) ------------------------------------------------------
# Local: run `npx prisma dev -n hq -d` and paste the postgres:// URL it prints.
# Keep `pgbouncer=true&connection_limit=1` on the local DATABASE_URL — the
# local dev server shares one backend, so prepared statements must be off.
# Vercel + Neon: both variables are set automatically by the Neon integration.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# --- Auth ---------------------------------------------------------------------
# Generate with: npx @better-auth/cli secret   (or any 32+ char random string)
BETTER_AUTH_SECRET=""
# The app's public URL. Optional on Vercel (the production URL is detected).
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional — the Google button is disabled until both are set).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <your app URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Scheduled discovery ------------------------------------------------------
# Required in production: protects /api/cron/check-all.
CRON_SECRET=""
