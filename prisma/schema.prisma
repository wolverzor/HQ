// HQ data model
// Postgres everywhere: locally via `npx prisma dev`, in production via
// Prisma Postgres or Neon (Vercel Storage) — see README.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core / identity — User, Session, Account and Verification follow the
// schema Better Auth expects (see src/lib/auth.ts).
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  tasks         Task[]
  timeBlocks    TimeBlock[]
  projects      Project[]
  companies     Company[]
  opportunities Opportunity[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]
}

// ---------------------------------------------------------------------------
// Task manager
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskCategory {
  FINANCE_CAREER
  UNIVERSITY
  PERSONAL
  PROJECTS
}

model Task {
  id                String       @id @default(cuid())
  title             String
  description       String?
  deadline          DateTime?
  priority          Priority     @default(MEDIUM)
  category          TaskCategory @default(PERSONAL)
  estimatedMinutes  Int?
  status            TaskStatus   @default(TODO)
  order             Int          @default(0)
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  timeBlocks TimeBlock[]

  @@index([userId, status])
  @@index([userId, deadline])
}

// ---------------------------------------------------------------------------
// Time blocker
// ---------------------------------------------------------------------------

model TimeBlock {
  id          String   @id @default(cuid())
  title       String
  start       DateTime
  end         DateTime
  color       String   @default("#6366f1")
  completed   Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, start])
}

// ---------------------------------------------------------------------------
// Finance opportunity tracker
// ---------------------------------------------------------------------------

enum Division {
  INVESTMENT_BANKING
  SALES_AND_TRADING
  ASSET_MANAGEMENT
  PRIVATE_EQUITY
  HEDGE_FUNDS
  QUANTITATIVE_FINANCE
  OTHER
}

enum ProgrammeType {
  SPRING_WEEK
  FIRST_YEAR_INTERNSHIP
  INSIGHT_PROGRAMME
  OTHER
}

enum OpportunityStatus {
  NOT_OPEN
  OPEN
  APPLYING
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  CLOSED
}

enum VerificationStatus {
  CONFIRMED_OPEN
  NEEDS_VERIFICATION
  CLOSED
  UNKNOWN
}

model Company {
  id         String   @id @default(cuid())
  name       String
  website    String?
  careersUrl String?
  enabled    Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  opportunities Opportunity[]
  checkRuns     CheckRun[]

  @@index([userId])
}

model Opportunity {
  id             String              @id @default(cuid())
  company        Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId      String?
  companyName    String
  programme      String
  division       Division            @default(OTHER)
  programmeType  ProgrammeType       @default(OTHER)
  location       String?
  openingDate    DateTime?
  deadline       DateTime?
  applicationUrl String?
  status         OpportunityStatus   @default(NOT_OPEN)
  dateApplied    DateTime?
  notes          String?
  source         String?
  sourceUrl      String?
  officialUrl    String?

  verificationStatus VerificationStatus @default(UNKNOWN)
  lastCheckedAt      DateTime?
  lastVerifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([userId, status])
  @@index([userId, deadline])
}

model CheckRun {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  success     Boolean  @default(false)
  message     String
  matchCount  Int      @default(0)

  @@index([companyId])
}
